# These are ENVIRONMENT VARIABLES. The app does NOT read a .env file automatically:
# set them in the shell before starting uvicorn (PowerShell: $env:PRELOAD_MODEL="true").
APP_ENV=development
HOST=0.0.0.0
PORT=8000
# Model (P1A). Pin MODEL_REVISION to a commit hash after the first successful run.
MODEL_ID=stabilityai/sd-turbo
# MODEL_REVISION=
# DEVICE=auto            # auto | cuda | cpu
# PRELOAD_MODEL=false    # true = load the model at startup so the first request is not slow
# SUPPORTED_RESOLUTIONS=256,384,512,640,768
# OUTPUT_DIR=generated_images
# PUBLIC_BASE_URL=       # only if behind a proxy/tunnel, e.g. https://abc.example.com
# MAX_STORED_IMAGES=200
# HF_HOME=               # Hugging Face cache location (model download is several GB)
# P4 optimization (defaults reproduce P1A: fp16 on CUDA / fp32 on CPU, nothing else on)
# PRECISION=auto         # auto | fp32 | fp16 | bf16
# ATTENTION_SLICING=false
# VAE_SLICING=false
# OFFLOAD=none           # none | model | sequential (CUDA only)
# WEIGHTS_VARIANT=auto   # auto | fp16 | none
# CV_MODE=off            # off | assess | correct  (P5B classical CV; off = unchanged behaviour)
# P6 adaptive controller (OFF unless ADAPTIVE_PROFILE is set; see docs/P6_ADAPTIVE.md)
# ADAPTIVE_PROFILE=evaluation/profiles/<gpu>.json   # built by evaluation/scripts/build_adaptive_profile.py
# ADAPTIVE_POLICY=                                  # optional policy JSON; defaults are UNCALIBRATED
# ADAPTIVE_ALLOW_SYNTHETIC=false                    # true only for demos with the synthetic fixture
# ADAPTIVE_DECISION_LOG=evaluation/results/p6/decisions.jsonl
# ADAPTER_PATH=         # P3B: folder of an APPROVED LoRA adapter (needs MODEL_REVISION pinned to its base revision). Unset = base model
# ADAPTER_WEIGHT=1.0    # 0-1 LoRA influence scale; set to the reviewed value when an adapter is approved
# Safety: set a long random shared secret before exposing the server beyond your own machine. Clients must then send
# it as the X-API-Key header on /api/v1/*. /health and /images/* stay open (image ids are unguessable 128-bit values).
# Unset = no authentication (fine for localhost development only). Min 16 characters.
# API_KEY=
# Groq assistant (server-side only; never expose this in frontend code).
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
