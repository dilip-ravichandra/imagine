# Copy to docker/.env (start.bat / start.sh do this for you) and edit. Everything is optional.

# Port on your laptop
PORT=8000

# AI assistant, translation, lessons, voice and "ask about an image" use Groq (free key: https://console.groq.com/keys).
# Without it the site still creates and edits images; those features show a friendly "not configured" message.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional second vision provider (fallback only)
GEMINI_API_KEY=

# Create an administrator on first start (sees the team dashboard). Use a long password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Let anyone who can reach the site make an account? 1 = yes (fine on your own laptop), 0 = no
ALLOW_SIGNUP=1

# auto | cpu | cuda
DEVICE=auto
